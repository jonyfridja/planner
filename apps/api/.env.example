PORT=3000
NODE_ENV=development

# Points at the local Postgres container started by `docker compose up -d` (see the
# root docker-compose.yml `db` service). In production this is instead set to a
# connection string for an external/shared Postgres instance.
DATABASE_URL=postgresql://planner:planner@localhost:5432/planner

# GlitchTip ingest DSN for error tracking (Phase 4). Obtained from the GlitchTip UI
# (Settings > Projects > your project > Client Keys/DSN) after first login. Leave
# blank for local dev — Sentry.init() no-ops without a dsn.
GLITCHTIP_DSN=

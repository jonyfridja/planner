# Used by docker-compose.yml when deploying with `docker compose up -d --build`.
# Copy to `.env` in the repo root on the deploy host (e.g. the Raspberry Pi) and fill in
# real values. This file is never read for local `pnpm dev` — see apps/api/.env for that.
#
# Note: the Cloudflare Tunnel is NOT managed here. It runs as a host-level systemd service
# (shared across every app on the box, not just this one) — see the Pi setup notes. It only
# needs a single ingress rule pointing at this box's :80 — the `proxy` service in
# docker-compose.yml is the single entry point and dispatches by path from there.

# Local Postgres container (the `db` service below), used by umami and glitchtip only.
DB_USERNAME=planner
DB_PASSWORD=change-me
DB_NAME=planner

# Host port Postgres is published on. Only override this if 5432 is already taken by
# another app on the same box (e.g. set to 5433).
DB_HOST_PORT=5432

# Connection string for the api service's Postgres database. This is a *separate*,
# shared Postgres instance reachable over the pre-existing `shared-db-net` docker
# network (see the `api` service's `networks:` in docker-compose.yml) — not the local
# `db` container above. Create the network once on the deploy host if it doesn't
# already exist: `docker network create shared-db-net`.
DATABASE_URL=postgresql://user:password@host:5432/planner

# Monitoring dashboards (Phase 1): Uptime Kuma, Netdata, Dozzle. They live behind the
# "monitoring" compose profile so a plain `docker compose up -d` (e.g. for local dev)
# doesn't start them. Uncomment the line below on the deploy host to enable them —
# they are not exposed via the public Cloudflare Tunnel; reach them over SSH
# tunnel/LAN/Tailscale to the Pi.
# COMPOSE_PROFILES=monitoring

# Only override the ports below if the default is already taken by another app on the
# same box.
UPTIME_KUMA_PORT=3001
NETDATA_PORT=19999
DOZZLE_PORT=8888

# Web activity tracking (Phase 3): Umami. Reuses the `db` Postgres container (create
# the `umami` database once before first boot — see the comment on the `umami`
# service in docker-compose.yml). APP_SECRET should be a random string, e.g.
# `openssl rand -hex 32`. Unlike the monitoring dashboards above, Umami needs to be
# reachable by real visitors' browsers — it is fronted by the `proxy` service at
# /planner-umami/, so no host port of its own is needed.
UMAMI_APP_SECRET=change-me

# Baked into the web app's static build (Vite env vars are resolved at build time,
# not read at container runtime) so the tracking script knows where to send events.
# Point this at the /umami/ path fronted by the `proxy` service, e.g.
# https://your-domain.example/umami/script.js. Leave both blank to build web
# without any tracking script.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

# Error tracking (Phase 4): GlitchTip. Reuses the `db` Postgres container (create the
# `glitchtip` database once before first boot — see the comment on the `glitchtip`
# service in docker-compose.yml). SECRET_KEY should be a random string, e.g.
# `openssl rand -hex 32`. GlitchTip's dashboard is ops-only like the monitoring
# dashboards above — do not put it on the public Cloudflare Tunnel.
GLITCHTIP_SECRET_KEY=change-me
GLITCHTIP_PORT=8001
# GLITCHTIP_EMAIL_URL=consolemail://
# GLITCHTIP_DOMAIN=http://localhost:8001
# GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost

# API's ingest DSN for reporting errors to GlitchTip, obtained from the GlitchTip UI
# (Settings > Projects > your project > Client Keys/DSN) after first login. Also add
# this to apps/api/.env(.example) — see there for local-dev usage.
GLITCHTIP_DSN=
